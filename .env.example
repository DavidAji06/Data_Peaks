# Copy to .env (gitignored) and fill in. Never commit real keys.

# ACAPS API token (ml/pipeline/fetch_acaps.py)
ACAPS_TOKEN=

# GreenPT LLM (ml/pipeline/greenpt.py)
GREENPT_API_KEY=
GREENPT_MODEL=deepseek-v4.1-flash
# Hard stop: no new uncached call once the estimated total spend reaches this (USD)
GREENPT_BUDGET_USD=10.00
# Optional: GREENPT_BASE_URL (default https://api.greenpt.ai/v1),
# GREENPT_REASONING (default "none" = thinking off; keep it off)
