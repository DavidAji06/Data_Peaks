# Copy to backend/.env (git-ignored) and fill in to send real emails (invites, welcome, sign-in links).
#
# EMAIL_PROVIDER picks the transport: "smtp" or "brevo". Left empty, Brevo's HTTPS API is used
# when BREVO_API_KEY is set, SMTP otherwise. With neither configured, links are only printed.
# EMAIL_PROVIDER=
# EMAIL_FROM=ACAPS expert panel <you@gmail.com>   (falls back to SMTP_FROM, then SMTP_USER)

# Option A: Brevo over HTTPS (use this on Render's free plan, which blocks outbound SMTP).
# Brevo > SMTP & API > API keys > Generate a new API key ("xkeysib-...", not the SMTP key).
# EMAIL_FROM / SMTP_FROM must be a sender verified in Brevo.
# BREVO_API_KEY=xkeysib-xxxxxxxx

# Option B: SMTP, e.g. Brevo (smtp-relay.brevo.com, SMTP key as password) or a Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=ACAPS expert panel <your.address@gmail.com>

# Where the links in emails point (the expert app)
EXPERT_APP_URL=http://localhost:8080

# Moderator API key (the dashboard sends it from frontend/.env.local)
# MODERATOR_KEY=dev-moderator-key
