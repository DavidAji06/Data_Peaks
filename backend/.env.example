# Copy to backend/.env (git-ignored) and fill in to send real emails (invites, welcome, sign-in links).
#
# EMAIL_PROVIDER picks the transport: "smtp" or "resend". Left empty, Resend is used when
# RESEND_API_KEY is set, SMTP otherwise. With neither configured, links are only printed.
# EMAIL_PROVIDER=
# EMAIL_FROM=ACAPS expert panel <panel@your-domain.org>   (falls back to SMTP_FROM, then SMTP_USER)

# Option A: Resend over HTTPS (use this on Render's free plan, which blocks outbound SMTP).
# Create a key at https://resend.com/api-keys. Until you verify a domain, send from
# EMAIL_FROM=onboarding@resend.dev, which only delivers to your own Resend account address.
# RESEND_API_KEY=re_xxxxxxxx

# Option B: SMTP. Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=ACAPS expert panel <your.address@gmail.com>

# Where the links in emails point (the expert app)
EXPERT_APP_URL=http://localhost:8080

# Moderator API key (the dashboard sends it from frontend/.env.local)
# MODERATOR_KEY=dev-moderator-key
